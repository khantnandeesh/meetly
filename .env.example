# Which media provider this build uses: "livekit" (default) or "realtimekit".
# Read at build time (it is a NEXT_PUBLIC_ value), so rebuild after changing it.
NEXT_PUBLIC_RTC_PROVIDER=livekit

# --- LiveKit (NEXT_PUBLIC_RTC_PROVIDER=livekit) ---
# LiveKit Cloud: https://cloud.livekit.io -> Settings -> Keys
# Local dev server (`livekit-server --dev`): ws://localhost:7880 / devkey / secret
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare RealtimeKit (NEXT_PUBLIC_RTC_PROVIDER=realtimekit) ---
# Cloudflare dashboard -> Realtime -> RealtimeKit. The app id is the RealtimeKit app's id.
CLOUDFLARE_ACCOUNT_ID=
REALTIMEKIT_APP_ID=
# Names of two presets in that app: one that may mute and remove people, one that may not.
REALTIMEKIT_HOST_PRESET=
REALTIMEKIT_GUEST_PRESET=
# Optional: a guest preset with the waiting room switched on. Setting it makes "People ask to
# join" available (the host preset also needs accept_waiting_requests). See the README.
# REALTIMEKIT_KNOCK_PRESET=
# Webinars ("New webinar" on the home page) need three more presets, all with view_type WEBINAR:
# - the host's: audio, video and screen share ALLOWED; can_accept_production_requests and
#   can_change_participant_permissions on;
# - the audience's: audio, video and screen share CAN_REQUEST; public chat can_send off; polls
#   can_vote on; no waiting room; no moderation;
# - a co-host's: audio, video and screen share CAN_REQUEST; accept_waiting_requests,
#   can_accept_production_requests, can_change_participant_permissions, disable_participant_audio
#   and _video, kick_participant; polls; public chat can_send; no recording.
# Without all three, making a webinar fails with "Webinars aren't set up on this server yet."
# Meetings are unaffected. See the README's Webinars section.
REALTIMEKIT_WEBINAR_HOST_PRESET=meetly-webinar-host
REALTIMEKIT_WEBINAR_VIEWER_PRESET=meetly-webinar-viewer
REALTIMEKIT_WEBINAR_COHOST_PRESET=meetly-webinar-cohost
# API token with the "Realtime" permission. Server only.
CLOUDFLARE_API_TOKEN=
# Any long random string (for example `openssl rand -hex 32`). Signs Meetly's own session
# tokens, which is how the server knows who the host is. Server only; changing it signs
# everyone out of host controls until they rejoin.
MEETLY_SESSION_SECRET=

# Webinars, either provider: how many people may watch one at a time. The host and the people on
# stage are not counted on LiveKit; on RealtimeKit they are (it says how many are connected, not
# who). Defaults to 250.
# MEETLY_WEBINAR_VIEWER_CAP=250

# Show "How was the call?" on the leave screen. Leave unset until src/lib/usage.ts sends answers somewhere.
# NEXT_PUBLIC_CALL_RATING=1
